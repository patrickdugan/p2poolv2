+
+/// The 32-byte assertion encoding of any 256-bit value `n`, including n >= r, exactly as
+/// `get_assertion_from_segments` encodes a public input.
+pub fn api_u256_assertion_bytes(n: ark_ff::BigInt<4>) -> [u8; 32] {
+    crate::chunk::elements::CompressedStateObject::U256(n)
+        .serialize_to_byte_array()
+        .try_into()
+        .unwrap()
+}
+
+/// Witness (hint script) for disprove leaf `leaf_index`, built from `signed_asserts` whether or
+/// not that leaf succeeds. None when the leaf's segment lies after the first faulty segment and
+/// so cannot be derived.
+pub fn api_disprove_witness_for_leaf(
+    vk: &ark_groth16::VerifyingKey<Bn254>,
+    signed_asserts: Signatures,
+    leaf_index: usize,
+) -> Option<Script> {
+    let asserts = get_assertions_from_signature(signed_asserts.clone());
+    let (_success, segments) = get_segments_from_assertion(asserts, vk.clone());
+    crate::chunk::api_runtime_utils::disprove_witness_for_leaf(&segments, signed_asserts, leaf_index)
+}
+
+/// Witnesses (hint scripts) for every disprove leaf, in leaf order. One pass over the segments,
+/// where `api_disprove_witness_for_leaf` rebuilds them for each leaf.
+pub fn api_disprove_witnesses_for_all_leaves(
+    vk: &ark_groth16::VerifyingKey<Bn254>,
+    signed_asserts: Signatures,
+) -> Vec<Script> {
+    let asserts = get_assertions_from_signature(signed_asserts.clone());
+    let (_success, segments) = get_segments_from_assertion(asserts, vk.clone());
+    crate::chunk::api_runtime_utils::disprove_witnesses_for_all_leaves(&segments, signed_asserts)
+}
