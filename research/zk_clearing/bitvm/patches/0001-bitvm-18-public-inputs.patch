+/// zk_clearing M1: the hint script for one disprove leaf, built the same way as the per-segment
+/// witness in `execute_script_from_signature` and `utils_execute_chunked_g16`.
+pub(crate) fn disprove_witness_for_leaf(
+    segments: &[Segment],
+    signed_assts: Signatures,
+    leaf_index: usize,
+) -> Option<Script> {
+    disprove_witnesses_for_all_leaves(segments, signed_assts)
+        .into_iter()
+        .nth(leaf_index)
+}
+
+/// zk_clearing M12: the hint script of every disprove leaf, in leaf order, from one pass over
+/// the segments.
+pub(crate) fn disprove_witnesses_for_all_leaves(
+    segments: &[Segment],
+    signed_assts: Signatures,
+) -> Vec<Script> {
+    let mut sigs: Vec<SigData> = vec![];
+    sigs.extend(signed_assts.0.iter().map(|f| SigData::Wots32(*f)));
+    sigs.extend(signed_assts.1.iter().map(|f| SigData::Wots32(*f)));
+    sigs.extend(signed_assts.2.iter().map(|f| SigData::Wots16(*f)));
+    let mul_hints = utils_collect_mul_hints_per_segment(segments);
+
+    let mut witnesses = vec![];
+    for (i, seg) in segments.iter().enumerate() {
+        if seg.scr_type == ScriptType::NonDeterministic {
+            continue;
+        }
+        let mut index_of_bitcommitted_msg: Vec<u32> =
+            seg.parameter_ids.iter().rev().map(|(k, _)| *k).collect();
+        if !seg.scr_type.is_final_script() {
+            index_of_bitcommitted_msg.push(seg.id);
+        }
+        let mut sig_preimages = script! {};
+        for index in index_of_bitcommitted_msg {
+            let sig_preimage = match &sigs[index as usize] {
+                SigData::Wots16(signature) => Wots16::compact_signature_to_raw_witness(
+                    &Wots16::signature_to_compact_signature(signature),
+                ),
+                SigData::Wots32(signature) => Wots32::compact_signature_to_raw_witness(
+                    &Wots32::signature_to_compact_signature(signature),
+                ),
+            };
+            sig_preimages = script! {
+                {sig_preimages}
+                {sig_preimage}
+            };
+        }
+        witnesses.push(script! {
+            for h in &mul_hints[i] {
+                {h.push()}
+            }
+            {sig_preimages}
+        });
+    }
+    witnesses
+}
